<?xml version="1.0" encoding="utf-8"?>
<!-- Painel esquerdo: Informações. Relógio em destaque, data e espaço reservado para dados do veículo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/JeepCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Cabeçalho do painel -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_navigation"
            android:contentDescription="@string/panel_info_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.Jeep.PanelTitle"
            android:text="@string/panel_info_title" />
    </LinearLayout>

    <!-- Relógio principal em destaque -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/info_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Jeep.BigClock"
                android:gravity="center"
                android:text="@string/clock_placeholder_time" />

            <TextView
                android:id="@+id/info_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Jeep.BigDate"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:text="@string/clock_placeholder_date" />
        </LinearLayout>
    </FrameLayout>

    <!-- Espaço reservado para informações do veículo (discreto, sem dados fictícios) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vehicle_block_height"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="14dp"
        android:background="@drawable/bg_vehicle_block">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_car"
            android:contentDescription="@string/panel_vehicle_block_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/panel_vehicle_block_title"
            android:textColor="@color/jeep_text_secondary"
            android:textSize="@dimen/vehicle_block_title_text"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/panel_vehicle_block_hint"
            android:textColor="@color/jeep_text_hint"
            android:textSize="@dimen/vehicle_block_hint_text"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
