<?xml version="1.0" encoding="utf-8"?>
<!-- Barra superior: relógio digital, data, indicadores visuais neutros e área de status reservada.
     Os ícones de Bluetooth e localização são apenas visuais nesta etapa (sem estados de conexão). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_top_bar"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding">

    <!-- Relógio e data -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/top_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clock_placeholder_time"
            android:textColor="@color/jeep_text_primary"
            android:textSize="@dimen/top_bar_time_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/top_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clock_placeholder_date"
            android:textColor="@color/jeep_text_secondary"
            android:textSize="@dimen/top_bar_date_text" />
    </LinearLayout>

    <!-- Área reservada para informações de status do veículo (centralizada verticalmente) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/top_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/top_status_reserved"
            android:textColor="@color/jeep_text_hint"
            android:textSize="@dimen/top_status_text"
            android:gravity="center" />
    </LinearLayout>

    <!-- Indicadores visuais (sem integração real nesta etapa) -->
    <ImageView
        android:id="@+id/indicator_bluetooth"
        android:layout_width="@dimen/top_bar_icon_size"
        android:layout_height="@dimen/top_bar_icon_size"
        android:layout_marginStart="@dimen/top_bar_icon_padding"
        android:src="@drawable/ic_bluetooth"
        android:contentDescription="@string/cd_bluetooth" />

    <ImageView
        android:id="@+id/indicator_location"
        android:layout_width="@dimen/top_bar_icon_size"
        android:layout_height="@dimen/top_bar_icon_size"
        android:layout_marginStart="@dimen/top_bar_icon_padding"
        android:src="@drawable/ic_location"
        android:contentDescription="@string/cd_location" />

</LinearLayout>
